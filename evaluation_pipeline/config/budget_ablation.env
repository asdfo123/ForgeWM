# Optional ForgeWM-1/2 native-budget ablation using the main-table metrics.
# Override any value in the shell before launching run_evaluation.sh.

REFERENCE_ROOT="${REFERENCE_ROOT:-$PIPELINE_DIR/data/reference}"
EVAL_ROOT="${EVAL_ROOT:-$PIPELINE_DIR/data/native_budget_eval}"
GT_MANIFEST="${GT_MANIFEST:-$REFERENCE_ROOT/gt_1000/manifest.tsv}"
MODELS="${MODELS:-forgewm1 forgewm2}"
GPU_LIST="${GPU_LIST:-0 1 2 3}"

PYTHON_GPU="${PYTHON_GPU:-python3}"
PYTHON_IDM="${PYTHON_IDM:-$PYTHON_GPU}"
DA3_MODEL="${DA3_MODEL:-depth-anything/DA3-GIANT-1.1}"
VJEPA_MODEL="${VJEPA_MODEL:-facebook/vjepa2-vitl-fpc64-256}"
GAMEWORLD_ROOT="${GAMEWORLD_ROOT:-$PIPELINE_DIR/external/Matrix-Game/Matrix-Game-1/GameWorldScore}"
VBENCH_ROOT="${VBENCH_ROOT:-$PIPELINE_DIR/external/VBench}"
VBENCH_LOCAL_CKPT="${VBENCH_LOCAL_CKPT:-0}"
IDM_CACHE="${IDM_CACHE:-$PIPELINE_DIR/external/checkpoints/idm}"
IDM_MODEL="${IDM_MODEL:-$IDM_CACHE/4x_idm.model}"
IDM_WEIGHTS="${IDM_WEIGHTS:-$IDM_CACHE/4x_idm.weights}"
CLIP_CHECKPOINT="${CLIP_CHECKPOINT:-ViT-B/32}"
DINO_REPO="${DINO_REPO:-$VBENCH_ROOT/.cache/dino_model/facebookresearch_dino_main}"
DINO_CHECKPOINT="${DINO_CHECKPOINT:-$VBENCH_ROOT/.cache/dino_model/dino_vitbase16_pretrain.pth}"

FULL1000_EXPECTED="${FULL1000_EXPECTED:-1000}"
CONSTANT_EXPECTED="${CONSTANT_EXPECTED:-462}"
FRAMES="${FRAMES:-77}"
CPU_WORKERS="${CPU_WORKERS:-8}"
